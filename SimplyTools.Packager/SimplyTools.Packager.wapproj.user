<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Source>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</Source>
    <SmallTileSource>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</SmallTileSource>
    <MediumTileSource>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</MediumTileSource>
    <WideTileSource>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</WideTileSource>
    <LargeTileSource>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</LargeTileSource>
    <AppIconSource>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</AppIconSource>
    <SplashScreenSource>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</SplashScreenSource>
    <PackageLogoSource>E:\.SysFolder\Downloads\SimplyToolsIcon_fit.png</PackageLogoSource>
    <UapAppxPackageBuildMode>StoreAndSideload</UapAppxPackageBuildMode>
    <AppxShowAllApps>False</AppxShowAllApps>
    <AppxBuildConfigurationSelection>x64</AppxBuildConfigurationSelection>
    <PackageOptionalProjectsInIdeBuilds>False</PackageOptionalProjectsInIdeBuilds>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebuggerFlavor>AppHostLocalDebugger</DebuggerFlavor>
    <RemoteDebugEnabled>False</RemoteDebugEnabled>
  </PropertyGroup>
</Project>